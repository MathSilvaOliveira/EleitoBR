generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Municipio {
  id            Int    @id @default(autoincrement())
  codigo        String @unique
  nome          String
  uf            String
  perfis        EleitoradoPerfil[]
  perfisSociais PerfilSocial[]

  // Índice em uf para consultas de comparação entre estados (ex.: SP vs RJ)
  @@index([uf])
}

model FaixaEtaria {
  id        Int    @id @default(autoincrement())
  codigo    String @unique
  descricao String
  perfis    EleitoradoPerfil[]
}

model Escolaridade {
  id        Int    @id @default(autoincrement())
  codigo    String @unique
  descricao String
  perfis    EleitoradoPerfil[]
}

model EleitoradoPerfil {
  id             Int          @id @default(autoincrement())
  municipio      Municipio    @relation(fields: [municipioId], references: [id])
  municipioId    Int
  faixaEtaria    FaixaEtaria  @relation(fields: [faixaEtariaId], references: [id])
  faixaEtariaId  Int
  escolaridade   Escolaridade @relation(fields: [escolaridadeId], references: [id])
  escolaridadeId Int
  genero         String
  zona           String
  quantidade     Int

  // Unicidade por combinação completa incluindo zona eleitoral
  // cada linha do TSE representa uma zona específica de um município.
  @@unique([municipioId, faixaEtariaId, escolaridadeId, genero, zona])
  @@index([municipioId])
  @@index([faixaEtariaId])
  @@index([escolaridadeId])
  @@index([genero])

  // Índices compostos para os endpoints de cruzamento
  @@index([faixaEtariaId, genero])
  @@index([escolaridadeId, faixaEtariaId])
  @@index([escolaridadeId, genero])
}

model EstadoCivil {
  id        Int    @id @default(autoincrement())
  codigo    String @unique
  descricao String
  perfis    PerfilSocial[]
}

model RacaCor {
  id        Int    @id @default(autoincrement())
  codigo    String @unique
  descricao String
  perfis    PerfilSocial[]
}

/// Estado civil, raça/cor e grupos específicos do eleitorado, por município e
/// gênero. Fica fora de EleitoradoPerfil porque a granularidade é outra: cruzar
/// estas dimensões com zona, idade e escolaridade multiplicaria as linhas à toa.
model PerfilSocial {
  id             Int         @id @default(autoincrement())
  municipio      Municipio   @relation(fields: [municipioId], references: [id])
  municipioId    Int
  estadoCivil    EstadoCivil @relation(fields: [estadoCivilId], references: [id])
  estadoCivilId  Int
  racaCor        RacaCor     @relation(fields: [racaCorId], references: [id])
  racaCorId      Int
  quilombola     String      // 'S', 'N' ou 'NI' (não informado)
  genero         String
  quantidade     Int
  comBiometria   Int
  comDeficiencia Int
  comNomeSocial  Int

  @@unique([municipioId, estadoCivilId, racaCorId, quilombola, genero])
}

/// Identidade do arquivo do TSE que originou os dados em uso.
/// O portal publica sempre sob o mesmo nome ("ATUAL"), então sem este
/// registro não há como saber a qual recorte os números se referem.
model Importacao {
  id                Int      @id @default(autoincrement())
  arquivo           String
  bytes             BigInt
  sha256            String
  baixadoEm         DateTime
  carregadoEm       DateTime @default(now())
  linhasLidas       Int
  registrosGravados Int
  municipios        Int
  observacao        String?

  @@index([carregadoEm])
}
